# Copy this file to .env and fill in your values.

FLASK_ENV=development
FLASK_DEBUG=True

# REQUIRED in production. The app refuses to start on Render without it,
# because the built-in development default would let anyone forge a session
# cookie and sign in as the director.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# ── Database ──────────────────────────────────────────────────────────────
# Leave DATABASE_URL blank for local development and the app uses a SQLite file.
# Set it to your Neon/Supabase PostgreSQL URL for any real deployment.
# There is NO SQLite fallback when DATABASE_URL is set: if PostgreSQL cannot be
# reached the app fails to start rather than quietly writing to disposable
# storage. postgres:// is rewritten to postgresql:// automatically, and any
# ?sslmode= is stripped because sslmode is supplied via connect_args.
# DATABASE_URL=postgresql://user:pass@ep-xyz.neon.tech/neondb

# Optional: override the local SQLite file location (development only).
# SQLITE_DB_PATH=/absolute/path/to/school.db

# ── First-run master accounts ─────────────────────────────────────────────
# Used ONLY when the database is completely empty. If you leave these unset,
# strong random passwords are generated and printed once in the deploy log.
# BOOTSTRAP_DIRECTOR_PASSWORD=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_TEACHER_PASSWORD=

# ── School details ────────────────────────────────────────────────────────
SCHOOL_NAME=Chandrabhan Singh Public School
ACADEMIC_YEAR=2026-27

# Alert threshold (avg pillar score below this triggers a flag)
ALERT_THRESHOLD=2.0
